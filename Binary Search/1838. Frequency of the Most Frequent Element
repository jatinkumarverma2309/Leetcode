class Solution {
    public int maxFrequency(int[] nums, int k) {
        int n=nums.length;
        Arrays.sort(nums);
        int[] prefixSum=new int[n];
        prefixSum[0]=nums[0];
        for(int i=1;i<nums.length;i++){
            prefixSum[i]=nums[i]+prefixSum[i-1];
        }
        int result=0;
        for(int target=0;target<n;target++){
            result=Math.max(result,bs(target,nums,k,prefixSum));
        }
        return result;
    }
    public int bs(int target, int[] nums,int k,int[] prefixSum){
        int l=0;
        int r=target;
        int best=target;
        while(l<=r){
            int mid=l+(r-l)/2;
            int count=target-mid+1;
            int windowSum=count*nums[target];
            int currSum=prefixSum[target]-prefixSum[mid]+nums[mid];
            int ops=windowSum-currSum;
            if(ops>k){
                l=mid+1;
            }
            else{
                best=mid;
                r=mid-1;
            }
        }
        return target-best+1;
    }
}