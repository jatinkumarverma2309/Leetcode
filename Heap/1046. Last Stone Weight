class Solution {
    public int lastStoneWeight(int[] stones) {
        PriorityQueue<Integer> pq=new PriorityQueue<>(Collections.reverseOrder());
        for(int ele:stones){
            pq.add(ele);
        }
        while(pq.size()>1){
            int i=pq.remove();
            int j=pq.remove();
            if(i==j) continue;
            if(i!=j){
                pq.add(i-j);
            }
        }
        if(pq.size()==0) return 0;
        return pq.peek();
    }
}