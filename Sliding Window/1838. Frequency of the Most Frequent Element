class Solution {
    public int maxFrequency(int[] nums, int k) {
        int n=nums.length;
        long currSum=0;
        Arrays.sort(nums);
        int l=0;
        int r=0;
        int ans=0;
        for(r=0;r<n;r++){
            long target=nums[r];
            currSum+=nums[r];
            long windowSum=(r-l+1)*target;
            long ops=windowSum-currSum;
            if(ops>k){
                currSum-=nums[l];
                l++;
            }
            ans=Math.max(ans,r-l+1);
        }
        return ans;
    }
}