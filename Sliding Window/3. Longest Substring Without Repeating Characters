class Solution {
    public int lengthOfLongestSubstring(String s) {
        HashMap<Character,Integer> map=new HashMap<>();
        int i=0;
        int j=0;
        int maxLen=0;
        while(j<s.length()){
            char ch=s.charAt(j);
            if(map.containsKey(ch)){
                i=Math.max(i,map.get(ch)+1);
            }
            map.put(ch,j);
            int len=j-i+1;
            maxLen=Math.max(len,maxLen);
            j++;
        }
        return maxLen;
    }
}