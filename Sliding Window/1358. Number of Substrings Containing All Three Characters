class Solution {
    public int numberOfSubstrings(String s) {
        int lasta=-1;
        int lastb=-1;
        int lastc=-1;
        int count=0;
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(ch=='a'){
                lasta=i;
            }
            else if(ch=='b'){
                lastb=i;
            }
            else{
                lastc=i;
            }
            int min=Math.min(lasta,Math.min(lastb,lastc));
            if(min!=-1){
                count+=(min+1);
            }
        }
        return count;
    }
}