class Solution {
    public int[] getSubarrayBeauty(int[] nums, int k, int x) {
        int n=nums.length;
        int[] ans=new int[n-k+1];
        int[] freq=new int[51];
        for(int i=0;i<k;i++){
            if(nums[i]<0){
                freq[-nums[i]]++;
            }
        }
        int index=0;
        ans[index++]=xthsmallest(freq,x);
        for(int right=k;right<n;right++){
            
            int left=right-k;
            if(nums[left]<0){
                freq[-nums[left]]--;
            }
            if(nums[right]<0){
                freq[-nums[right]]++;
            }
            ans[index++]=xthsmallest(freq,x);
        }
        return ans;
    }
    public int xthsmallest(int[] freq,int x){
        int count=0;
        for(int i=50;i>=1;i--){
            count+=freq[i];
            if(count>=x){
                return -i;
            }
        }
        return 0;
    }
}