class Solution {
    public int numSubarraysWithSum(int[] nums, int goal) {
        return fun(nums,goal)-fun(nums,goal-1);
    }
    public int fun(int[] nums,int goal){
        int l=0;
        int r=0;
        int s=0;
        int res=0;
        if(goal<0) return 0;
        while(r<nums.length){
            s+=nums[r];
            
            while(s>goal){
                s-=nums[l];
                l++;
            }
            res+=(r-l+1);
            r++;
        }
        return res;
    }
}