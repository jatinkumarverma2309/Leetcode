class Solution{
    public ArrayList<Integer> TopologicalSort(int[][] edges){
        int n=edges.length;
        ArrayList<ArrayList<Integer>> adj=new ArrayList<>();
        for(int i=0;i<n;i++){
            adj.add(new ArrayList<>());
        }
        int[] indegree=new int[n];
        for(int i=0;i<edges.length;i++){
            int u=edges[i][0];
            int v=edges[i][1];
            adj.get(u).add(v);
            indegree[v]++;
        }

        Queue<Integer> q=new LinkedList<>();
        for(int i=0;i<n;i++){
            if(indegree[i]==0) q.add(i);
        }
        ArrayList<Integer> ans=new ArrayList<>();
        while(!q.isEmpty()){
            int front=q.remove();
            ans.add(front);
            for(int ele:adj.get(front)){
                if(indegree[ele]!=0){
                    indegree[ele]--;
                    if(indegree[ele]==0){
                        q.add(ele);
                    }
                }
            }
        }
        return ans;
    }
}



