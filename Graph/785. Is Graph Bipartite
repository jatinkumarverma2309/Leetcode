class Solution {
    public boolean isBipartite(int[][] graph) {
        int n=graph.length;
        int[] visited=new int[n];
        for(int i=0;i<n;i++){
            if(visited[i]==0){
                if(!bfs(i,visited,graph)) return false;
            }
        }
        return true;
    }
    private boolean bfs(int src,int[] visited,int[][] graph){
        visited[src]=1;
        Queue<Integer> q=new LinkedList<>();
        q.add(src);
        while(!q.isEmpty()){
            int vertex=q.remove();
            int color=visited[vertex];
            for(int i:graph[vertex]){
                if(visited[i]==0){
                    q.add(i);
                    visited[i]=3-color;
                }
                else if(visited[i]==color) return false;
            }
        }
        return true;
    }
}