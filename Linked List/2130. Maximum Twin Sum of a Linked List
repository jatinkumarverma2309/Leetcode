class Solution {
    public int pairSum(ListNode head) {
        ListNode slow=head;
        ListNode fast=head;
        while(fast.next!=null && fast.next.next!=null){
            fast=fast.next.next;
            slow=slow.next;
        }
        ListNode head2=slow.next;
        slow.next=null;
        head2=reverse(head2);
        ListNode i=head;
        ListNode j=head2;
        int max=0;
        int sum=0;
        while(j!=null){
            sum=i.val+j.val;
            max=Math.max(max,sum);
            i=i.next;
            j=j.next;
        }
        return max;
    }
    public ListNode reverse(ListNode head){
        ListNode curr=head;
        ListNode fwd=head;
        ListNode prev=null;
        while(curr!=null){
            fwd=curr.next;
            curr.next=prev;
            prev=curr;
            curr=fwd;
        }
        return prev;
    }
}