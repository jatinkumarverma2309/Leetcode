class Solution {
    public void reorderList(ListNode head) {
        ListNode slow=head;
        ListNode fast=head;
        while(fast.next!=null && fast.next.next!=null){
            fast=fast.next.next;
            slow=slow.next;
        }
        ListNode head2=slow.next;
        slow.next=null;
        head2=reverse(head2);
        merge(head,head2);
        return;
    }
    public ListNode reverse(ListNode head){
        ListNode curr=head;
        ListNode prev=null;
        ListNode fwd=head;
        while(curr!=null){
            fwd=curr.next;
            curr.next=prev;
            prev=curr;
            curr=fwd;
        }
        return prev;
    }
    public ListNode merge(ListNode head1, ListNode head2){
        ListNode dummy=new ListNode(-1);
        ListNode i=head1;
        ListNode j=head2;
        ListNode k=dummy;
        while(i!=null && j!=null){
            k.next=i;
            i=i.next;
            k=k.next;
            k.next=j;
            j=j.next;
            k=k.next;
        }
        if(i==null) k.next=j;
        else{
            k.next=i;
        }
        return dummy.next;
    }
}