class Solution {
    public int lastStoneWeightII(int[] stones) {
        int n=stones.length;
        int total=0;
        for(int stone:stones){
            total+=stone;
        }
        int target=total/2;
        int[][] dp=new int[n+1][target+1];
        for(int i=0;i<n;i++){
            Arrays.fill(dp[i],-1);
        }
        int ans=func(0,target,stones,dp);
        return total-2*ans;
    }
    public int func(int index,int target,int[] stones,int[][] dp){
        if(index==stones.length) return 0;
        if(dp[index][target]!=-1) return dp[index][target];
        if(stones[index]<=target){
            int include=stones[index]+func(index+1,target-stones[index],stones,dp);
            int exclude=func(index+1,target,stones,dp);
            return dp[index][target]=Math.max(include,exclude);
        }
        else{
            return dp[index][target]=func(index+1,target,stones,dp);
        }
    }
}